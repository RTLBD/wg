{
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up wg --build",
    "cli:dev": "docker compose -f docker-compose.dev.yml run --build --rm -it wg cli:dev",
    "build": "docker build -t wg .",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "docs:preview": "docker run --rm -it -p 8080:8080 -v ./docs:/docs squidfunk/mkdocs-material serve -a 0.0.0.0:8080",
    "scripts:version": "bash scripts/version.sh",
    "scripts:i18n": "bash scripts/i18n.sh",
    "format:check:docs": "prettier --check docs"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "packageManager": "pnpm@11.1.2"
}
