# Prebuilt fork image: replace app bundle in upstream wg-easy:15 runtime.
# Build locally first:
#   cd src && pnpm install && pnpm build
# Then:
#   docker build -f Dockerfile.prebuilt -t ghcr.io/lamirshahinxl/wg-easy:15-traffic-limit .

FROM ghcr.io/wg-easy/wg-easy:15

COPY docker-artifacts/.output /app
COPY docker-artifacts/migrations /app/server/database/migrations

LABEL org.opencontainers.image.source=https://github.com/lAmirshahinxl/wg-easy
